config_version=5

[application]

config/name="Dossier 25-10-4471 - Salle de jeu"
config/description="La salle de jeu de Julien Caron, le lendemain matin. Scène d'enquête point-and-click vue du dessus."
run/main_scene="res://scenes/game_room.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

