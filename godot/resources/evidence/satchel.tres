script = ExtResource("1_evidence")
id = &"satchel"
title = "Cartable de Julien"
description = "Plein de matériel de jeu : cartes, figurines, écrans. Au fond, dans une pochette : un d20 confisqué, lourd d'un côté. Celui de Samuel. Il n'est donc jamais remonté le chercher."
