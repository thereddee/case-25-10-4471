[node name="Lavoie" type="CharacterBody2D" parent="NPCs"]
position = Vector2(96, 360)
collision_layer = 4
collision_mask = 1
script = ExtResource("4_npc")
npc_name = "Sgt-dét. Lavoie"
lines = Array[String](["Le cri de {scream_time}, c'est ça, notre heure du décès. Les quatre étaient partis à {departure_time}. Prouvez-moi le contraire.", "Donc le cri ne voulait rien dire. Quelqu'un se trouvait dans cet appartement à {pause_time}. Je ne leur ai pas posé les bonnes questions.", "Deux d'entre eux ont menti. L'un est resté dehors, l'autre est remonté. Le jeu pourra peut-être les départager.", "Un paladin qui vole son propre temple. Caron a écrit ça pour une seule personne à la table.", "Il allait la démasquer deux fois : une fois comme paladin, une fois comme voleuse. Elle n'avait qu'à empêcher la première."])

